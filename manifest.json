{
  "manifest_version": 3,
  "name": "DC VPN Filter",
  "version": "1.0.0",
  "description": "VPN 유동의 게시글 차단",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.dcinside.com/*",
    "https://gall.dcinside.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DC VPN Filter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dcinside.com/*",
        "https://gall.dcinside.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ip.json"],
      "matches": [
        "https://*.dcinside.com/*",
        "https://gall.dcinside.com/*"
      ]
    }
  ]
}